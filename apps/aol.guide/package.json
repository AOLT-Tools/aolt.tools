{
  "name": "@aolt/aol-guide",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "pnpm --dir ../.. build:packages && node scripts/verify-functions.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "search": "tsx scripts/search.ts",
    "pincodes": "node scripts/update-pincode-data.mjs"
  },
  "dependencies": {
    "@aolt/core": "workspace:*",
    "@aolt/integrations": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@vercel/node": "8.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
