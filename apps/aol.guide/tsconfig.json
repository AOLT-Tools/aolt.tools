{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "vitest/globals"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "api",
    "lib",
    "scripts",
    "src",
    "tests",
    "vite.config.ts",
    "../../packages/shared/types/**/*.d.ts"
  ]
}
