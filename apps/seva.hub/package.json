{
  "name": "@aolt/seva-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "pnpm --dir ../.. build:packages && node scripts/verify-functions.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../.. build:packages && vitest run",
    "env:check": "pnpm --dir ../.. build:packages && node scripts/env-check.mjs",
    "sheets:template": "node scripts/generate-sheet-template.mjs",
    "sheets:doctor": "pnpm --dir ../.. build:packages && node scripts/sheets-doctor.mjs",
    "sheets:doctor:fix": "pnpm --dir ../.. build:packages && node scripts/sheets-doctor.mjs --fix"
  },
  "dependencies": {
    "@aolt/core": "workspace:*",
    "@aolt/integrations": "workspace:*",
    "@aolt/shared": "workspace:*",
    "@alpinejs/csp": "3.16.3",
    "lucide": "1.27.0",
    "nanoid": "6.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/alpinejs": "3.13.11",
    "@types/node": "26.4.0",
    "@vercel/node": "8.1.2",
    "google-auth-library": "11.0.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "xlsx": "0.18.5"
  }
}
