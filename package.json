{
  "name": "aolt-tools-monorepo",
  "version": "0.1.0",
  "description": "AOLT Tools pnpm workspace with independently deployable apps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:aol.guide": "pnpm --dir apps/aol.guide dev",
    "dev:seva.hub": "pnpm build:packages && pnpm --dir apps/seva.hub exec vercel dev",
    "build:packages": "pnpm --filter @aolt/shared build && pnpm --filter @aolt/core build && pnpm --filter @aolt/integrations build",
    "build:aol.guide": "pnpm --dir apps/aol.guide build",
    "build:seva.hub": "pnpm --dir apps/seva.hub build",
    "preview:aol.guide": "pnpm --dir apps/aol.guide preview",
    "preview:seva.hub": "pnpm --dir apps/seva.hub exec vercel preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --dir apps/aol.guide typecheck && pnpm --dir apps/seva.hub typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm build:packages && vitest run",
    "aol-guide:search": "pnpm --dir apps/aol.guide search",
    "aol-guide:pincodes": "pnpm --dir apps/aol.guide pincodes",
    "seva:env-check": "pnpm --dir apps/seva.hub env:check",
    "seva:sheets-template": "pnpm --dir apps/seva.hub sheets:template",
    "seva:sheets-doctor": "pnpm --dir apps/seva.hub sheets:doctor"
  },
  "dependencies": {
    "@alpinejs/csp": "3.16.3",
    "@aolt/core": "workspace:*",
    "@aolt/integrations": "workspace:*",
    "@aolt/shared": "workspace:*",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.5",
    "google-auth-library": "11.0.2",
    "jose": "6.2.10",
    "nanoid": "6.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/alpinejs": "3.13.11",
    "@types/node": "26.4.0",
    "@vercel/node": "8.1.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vercel": "^59.10.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "xlsx": "0.18.5"
  }
}
